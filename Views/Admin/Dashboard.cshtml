@model List<Post>
@{
    Layout = "_AdminLayout";
    ViewData["Baslik"] = "Yönetim Paneli";
}

<header class="admin-header">
    <div class="container">
        <div>Hoş geldin, <strong>@User.Identity?.Name</strong></div>
        <div>
            <a href="/" class="btn btn-ikincil" target="_blank" style="padding:8px 18px; font-size:0.9rem;">Siteyi Gör</a>
            <a href="/admin/sorular" class="btn" style="padding:8px 18px; font-size:0.9rem;">
                Sorular
                @if ((int)(ViewBag.BekleyenSoruSayisi ?? 0) > 0)
                {
                    <span style="background:#fff; color:var(--renk-turuncu-koyu); border-radius:50px; padding:2px 8px; margin-left:6px; font-weight:800;">@ViewBag.BekleyenSoruSayisi</span>
                }
            </a>
            <form asp-controller="Account" asp-action="Cikis" method="post" style="display:inline;">
                    <button type="submit" style="margin-left:12px; font-weight:700; color:#B23A3A; background:none; border:none; cursor:pointer; font-size:1rem;">Çıkış Yap</button>
            </form>
        </div>
    </div>
</header>

<div class="container">
    <div class="admin-panel genis">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
            <h2>Blog Yazılarım</h2>
            <a href="/admin/yazi-ekle" class="btn">+ Yeni Yazı</a>
        </div>

        @if (!Model.Any())
        {
            <p style="color:var(--renk-metin-acik);">Henüz bir yazı eklemediniz. "Yeni Yazı" butonuna tıklayarak başlayın.</p>
        }
        else
        {
            <table class="admin-tablo">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var y in Model)
                    {
                        <tr>
                            <td>@y.Baslik</td>
                            <td><span class="durum-etiket @y.Durum">@(y.Durum == "yayinda" ? "Yayında" : "Taslak")</span></td>
                            <td>@YardimciServisler.TarihFormatla(y.OlusturulmaTarihi)</td>
                            <td class="eylem-linkler">
                                <a class="duzenle" href="/admin/yazi-duzenle/@y.Id">Düzenle</a>
                                <form asp-action="YaziSil" asp-route-id="@y.Id" method="post" style="display:inline;"
                                      onsubmit="return confirm('Bu yazıyı silmek istediğinize emin misiniz?');">
                                                            <button type="submit" class="sil" style="background:none; border:none; cursor:pointer; font-weight:700; font-size:0.9rem; color:#B23A3A;">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
