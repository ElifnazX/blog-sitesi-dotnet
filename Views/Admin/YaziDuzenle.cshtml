@model YaziFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Baslik"] = "Yazıyı Düzenle";
}

<header class="admin-header">
    <div class="container">
        <a href="/admin" style="font-weight:700;">← Panele Dön</a>
    </div>
</header>

<div class="container">
    <div class="admin-panel">
        <h2 style="margin-bottom:24px;">Yazıyı Düzenle</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="uyari">@Html.ValidationSummary()</div>
        }

        @if (!string.IsNullOrEmpty(Model.MevcutKapakResim))
        {
            <img src="~/uploads/@Model.MevcutKapakResim" style="max-width:220px; margin-bottom:20px;">
        }

        <form asp-action="YaziDuzenle" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">

            <div class="form-grup">
                <label>Başlık</label>
                <input asp-for="Baslik" type="text" required>
            </div>

            <div class="form-grup">
                <label>Kısa Özet</label>
                <input asp-for="Ozet" type="text" maxlength="500">
            </div>

            <div class="form-grup">
                <label>Kapak Resmi (değiştirmek için yeni dosya seçin, boş bırakırsanız mevcut kalır)</label>
                <input asp-for="KapakResimDosya" type="file" accept="image/jpeg,image/png,image/webp">
            </div>

            <div class="form-grup">
                <label>İçerik</label>
                <textarea asp-for="Icerik" required></textarea>
            </div>

            <div class="form-grup">
                <label>Durum</label>
                <select asp-for="Durum">
                    <option value="taslak">Taslak (yayınlanmaz)</option>
                    <option value="yayinda">Yayınla</option>
                </select>
            </div>

            <button type="submit" class="btn">Güncelle</button>
        </form>
    </div>
</div>
