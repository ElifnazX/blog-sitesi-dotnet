@model List<Soru>
@{
    ViewData["Baslik"] = "Sıkça Sorulan Sorular";
}

<section>
    <div class="container">
        <div class="section-baslik">
            <h2>Sıkça Sorulan Sorular</h2>
            <p>Ziyaretçilerimizin sorduğu sorular ve cevapları</p>
        </div>

        @if (!Model.Any())
        {
            <p style="text-align:center; color:var(--renk-metin-acik);">Henüz cevaplanmış bir soru bulunmuyor.</p>
        }
        else
        {
            <div style="max-width:760px; margin:0 auto;">
                @foreach (var soru in Model)
                {
                    <div style="background:var(--renk-beyaz); border-radius:var(--radius); box-shadow:var(--golge); padding:24px; margin-bottom:20px;">
                        <p style="font-weight:700; color:var(--renk-turuncu-koyu); margin-bottom:10px;">S: @soru.SoruMetni</p>
                        <p>C: @soru.Cevap</p>
                    </div>
                }
            </div>
        }

        <div style="text-align:center; margin-top:30px;">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("kullanici"))
                {
                    <a href="/hesap/soru-sor" class="btn">Sen de Soru Sor</a>
                }
            }
            else
            {
                <a href="/hesap/kayit" class="btn">Hesap Oluştur ve Soru Sor</a>
            }
        </div>
    </div>
</section>
