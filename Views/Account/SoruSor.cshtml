@model SoruSorSayfaViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Baslik"] = "Soru Sor";
}

<header class="admin-header">
    <div class="container">
        <div>Hoş geldin, <strong>@User.Identity?.Name</strong></div>
        <div>
            <a href="/" class="btn btn-ikincil" target="_blank" style="padding:8px 18px; font-size:0.9rem;">Siteyi Gör</a>
            <form asp-controller="Account" asp-action="Cikis" method="post" style="display:inline;">
                <button type="submit" style="margin-left:12px; font-weight:700; color:#B23A3A; background:none; border:none; cursor:pointer; font-size:1rem;">Çıkış Yap</button>
            </form>
        </div>
    </div>
</header>

<div class="container">
    <div class="admin-panel">
        <h2 style="margin-bottom:20px;">Soru Sor</h2>

        @if (TempData["Basarili"] != null)
        {
            <div class="basarili">@TempData["Basarili"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="uyari">@Html.ValidationSummary()</div>
        }

        <form asp-action="SoruSor" method="post">
            <div class="form-grup">
                <label>Sorunuz</label>
                <textarea asp-for="YeniSoru.SoruMetni" required placeholder="Dil ve konuşma gelişimiyle ilgili merak ettiğinizi yazın..." style="min-height:120px;"></textarea>
            </div>
            <button type="submit" class="btn">Soruyu Gönder</button>
        </form>
    </div>

    <div class="admin-panel genis" style="margin-top:30px;">
        <h2 style="margin-bottom:20px;">Sorularım</h2>

        @if (!Model.Sorularim.Any())
        {
            <p style="color:var(--renk-metin-acik);">Henüz bir soru sormadınız.</p>
        }
        else
        {
            @foreach (var soru in Model.Sorularim)
            {
                <div style="border-bottom:1px solid #F1E7DA; padding:16px 0;">
                    <p style="font-weight:700;">@soru.SoruMetni</p>
                    <span class="durum-etiket @(soru.Durum == "cevaplandi" ? "yayinda" : "taslak")" style="margin-top:6px; display:inline-block;">
                        @(soru.Durum == "cevaplandi" ? "Cevaplandı" : "Bekliyor")
                    </span>
                    @if (soru.Durum == "cevaplandi")
                    {
                        <p style="margin-top:10px; color:var(--renk-metin-acik);"><strong>Cevap:</strong> @soru.Cevap</p>
                    }
                </div>
            }
        }
    </div>
</div>
